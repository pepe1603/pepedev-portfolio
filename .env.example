# ── Postgres (Terramount vía túnel SSH) ──────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portfolio_dev
SPRING_DATASOURCE_USERNAME=portfolio_app
SPRING_DATASOURCE_PASSWORD=cambia_esto

# ── Redis (Terramount vía túnel SSH) ─────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=cambia_esto

# ── JWT y CORS (ver Bloque 4 de PLAN-API.md) ────────────────────
# TTLs en SEGUNDOS (opcionales; sin ellas se usan 900 / 604800).
APP_JWT_ACCESS_TTL=900        # access: 15 min
APP_JWT_REFRESH_TTL=604800    # refresh: 7 días
APP_JWT_SECRET=generar_con_openssl_rand_base64_64
APP_JWT_REFRESH_SECRET=generar_otro_distinto_openssl_rand_base64_64
# True solo en producción (HTTPS obligatorio). Dev va por HTTP.
APP_JWT_REFRESH_COOKIE_SECURE=false
# Origen(es) del front en producción p. ej. https://pepe1603.dev (ver docs/PRODUCCION.md).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limit login (opcionales) ──────────────────────────────
# Si se superan los intentos dentro de la ventana → 429 + Retry-After.
APP_LOGIN_RATE_MAX_IP=5         # intentos fallidos por IP cada 15 min
APP_LOGIN_RATE_MAX_EMAIL=10     # intentos fallidos por email cada 15 min
APP_LOGIN_RATE_WINDOW=900       # ventana en segundos

# ── Email ─────────────────────────────────────────────────────────
# Dos usos distintos del correo en este proyecto:

# A) Usuario ADMIN (login al panel, NO es SMTP).
#    AdminBootstrap crea el admin SOLO si la tabla `users` está vacía.
#    Cambiar estas vars NO afecta a un admin ya existente en la BD.
APP_ADMIN_EMAIL=admin@pepe1603.dev
APP_ADMIN_SECRET=cambia_esto

# B) SMTP para enviar correos (Resend).
#    El health /actuator/health valida estas credenciales haciendo un login real
#    (MailHealthIndicator); si fallan, el health baja a DOWN.
#    OJO: en Resend el usuario SMTP es literal "resend", no un email.
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=cambia_esto

# Destino de los correos del formulario de contacto (Bloque 5.3): el mensaje se
# guarda en la tabla `messages` y se avisa por correo a esta dirección.
APP_CONTACT_DEST_EMAIL=contact@pepe1603.dev
# Remitente verificado en Resend (obligatorio para enviar). Si está vacío no se envía
# notificación, pero el mensaje sigue persistiéndose (best-effort).
APP_CONTACT_FROM_EMAIL=no-reply@pepe1603.dev
# Acuse al visitante: envía un correo de confirmación al remitente del formulario.
# `true` (default) envía notificación al admin + acuse; `false` solo la notificación.
APP_CONTACT_SEND_ACK=true
# Rate limit del formulario de contacto (opcionales): máximo de envíos por IP en la ventana.
APP_CONTACT_RATE_MAX_IP=5
APP_CONTACT_RATE_WINDOW=900

# ── Restablecimiento de contraseña (Sesión 5) ────────────────────
# Base del front donde el usuario escribe la nueva contraseña; la API le añade
# el token como query param (`?token=...`). Vacío = no se envía el correo.
APP_FRONT_RESET_URL=http://localhost:3000/reset-password
# Rate limit de la solicitud de reset por IP y ventana (segundos).
APP_RESET_RATE_MAX_IP=5
APP_RESET_RATE_WINDOW=900

# ── Segundo factor por email (OTP) (Sesión 5) ───────────────────
# Feature flag global. Aunque esté activo, cada usuario lo enciende con
# PATCH /admin/otp {"enabled": true}; con el flag en false el login sigue
# siendo de un solo paso aunque el usuario lo tenga activated.
APP_AUTH_OTP_ENABLED=false
# Vigencia del código (segundos) y máximo de intentos por challenge.
APP_AUTH_OTP_TTL=300
APP_AUTH_OTP_MAX_ATTEMPTS=5
# Enfriamiento entre reenvíos del mismo challenge (segundos). El
# reenvío genera un código nuevo y NO alarga el challenge.
APP_AUTH_OTP_RESEND_COOLDOWN=30

# ── Correo de seguridad ───────────────────────────────────────────
# Tres interruptores independientes. APP_MAIL_SECURITY_RESET arranca
# activado porque sin ese correo no hay recuperación de contraseña;
# los avisos de sesión arrancan apagados porque solo interesan si más de
# una persona entra al panel. Con cualquiera de los dos de sesión en true
# hace falta APP_CONTACT_FROM_EMAIL, o el aviso no sale (y se avisa por log).
# El aviso de login solo se envía si el acceso llega desde una IP o un
# navegador que el usuario no había usado antes.
APP_MAIL_SECURITY_LOGIN=false
APP_MAIL_SECURITY_LOGOUT=false
APP_MAIL_SECURITY_RESET=true

# ── Caché de respuestas públicas (Bloque 5) ──────────────────────
# GET /public/* con caché Redis ligera + ETag (304). TTL en segundos.
APP_PUBLIC_CACHE_TTL=300

# ── Storage (local FS servido por la propia API, Bloque 6.3) ─────
APP_STORAGE_DIR=/home/pepe-dev/Projects/pepedev-portfolio/uploads
APP_STORAGE_PUBLIC_URL=http://localhost:8080/files

# ── Front (Nuxt) ──────────────────────────────────────────────────
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
NUXT_PUBLIC_SITE_URL=http://localhost:3000