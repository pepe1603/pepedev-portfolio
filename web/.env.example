# ---------------------------------------------------------------------------
# Frontend Nuxt (web/)
# Copia este archivo a .env y rellena los valores del entorno.
# ---------------------------------------------------------------------------

# URL base de la API de Spring. El navegador la usa para las llamadas
# publicas (/public/**) y el servidor de Nitro como intermediario (BFF) para
# /auth/** y /admin/**. En docker/despliegue apunta al host interno de la API.
NUXT_PUBLIC_API_BASE=http://localhost:8080

# URL publica del frontend. Se usa en canonical, Open Graph, sitemap y robots.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave de cifrado de la cookie de sesion sellada (nuxt-auth-utils).
# Minimo 32 caracteres. Genera una distinta por entorno con:
#   openssl rand -base64 48
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-characters-long

# h3 marca la cookie de sesion como Secure por defecto. En desarrollo sobre
# http (acceso por IP en la LAN) no se enviaria; descomenta esta linea:
# NUXT_SESSION_COOKIE_SECURE=false
